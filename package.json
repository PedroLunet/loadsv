{
	"name": "loadsv",
	"version": "0.1.0",
	"description": "A lightweight library of beautiful loading indicators for Svelte. Pure CSS, no dependencies.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PedroLunet/loadsv.git"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"sveltekit",
		"svelte-component",
		"spinner",
		"spinners",
		"loader",
		"loading",
		"loading-indicator",
		"loading-spinner",
		"indicator",
		"animation",
		"css-animation"
	],
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"sideEffects": [
		"**/*.css",
		"./.svelte-kit/**"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.16.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "npm run clean && wrangler types --check && vite build",
		"clean": "node -e \"fs.rmSync('.svelte-kit/cloudflare', { recursive: true, force: true })\"",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen": "wrangler types",
		"test:unit": "vitest",
		"test:e2e": "playwright install chromium && playwright test",
		"test": "vitest run && npm run test:e2e"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"publint": "^0.3.24",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^5.0.1",
		"wrangler": "^4.97.0"
	}
}
